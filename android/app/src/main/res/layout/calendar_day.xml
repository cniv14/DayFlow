<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="2dp">
    <TextView android:id="@+id/day_number" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/day_lunar" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="9sp" android:gravity="center" android:singleLine="true" android:ellipsize="end" />
    <TextView android:id="@+id/day_marker" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:text=" " />
</LinearLayout>
