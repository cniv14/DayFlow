<Window x:Class="DayFlow.Widget.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="日栖 DayFlow" Width="390" Height="680" MinWidth="320" MinHeight="440" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip" Topmost="True">
 <Border CornerRadius="26" BorderBrush="#88FFFFFF" BorderThickness="1" ClipToBounds="True">
  <Grid>
   <Border x:Name="Wallpaper" Background="#E5EEE5" CornerRadius="26"/>
   <Border x:Name="Glass" Background="#CCF6F8F2" CornerRadius="26"/>
   <DockPanel Margin="22,16,22,18">
    <Grid DockPanel.Dock="Top" MouseLeftButtonDown="DragHeader" Margin="0,0,0,15">
     <StackPanel><TextBlock Text="日栖" FontSize="28" FontWeight="Bold" Foreground="#1D3A32"/><TextBlock x:Name="DateLabel" FontSize="11" Foreground="#61756B" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Button Content="⚙" Click="SettingsClick"/><Button Content="—" Click="MinimizeClick"/><Button Content="×" Click="CloseClick"/></StackPanel>
    </Grid>
    <StackPanel DockPanel.Dock="Bottom">
     <WrapPanel HorizontalAlignment="Center"><Button Content="＋ 记录" Click="AddClick"/><Button Content="文件同步" Click="FilesClick"/><Button Content="云 / 局域网" Click="SyncClick"/></WrapPanel>
     <TextBlock x:Name="StatusLabel" Text="本地模式 · 无需账号" FontSize="11" Foreground="#61756B" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Items"/></ScrollViewer>
   </DockPanel>
  </Grid>
 </Border>
</Window>
