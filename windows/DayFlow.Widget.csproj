<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DayFlow.Widget</AssemblyName>
    <Version>0.3.0</Version>
    <DefaultItemExcludes>$(DefaultItemExcludes);Updater/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../shared/UpdateFeed.cs" Link="UpdateFeed.cs" />
    <EmbeddedResource Include="../update-public.pem" LogicalName="DayFlow.UpdateKey" />
  </ItemGroup>
</Project>
